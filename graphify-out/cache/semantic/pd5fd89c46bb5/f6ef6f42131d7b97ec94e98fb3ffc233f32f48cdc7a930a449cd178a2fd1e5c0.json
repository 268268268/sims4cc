{"nodes": [{"id": "_cline_skills_ponytail_skill_ponytail", "label": "Ponytail Skill (lazy senior developer mode)", "file_type": "document", "source_file": ".cline/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_cline_skills_ponytail_skill_laziness_ladder", "label": "The Ladder (decision ladder for minimal solutions)", "file_type": "rationale", "source_file": ".cline/skills/ponytail/SKILL.md", "source_location": "The ladder section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop at the first rung that holds: skip entirely (YAGNI), then stdlib, then native platform feature, then already-installed dependency, then one line, and only then minimum custom code \u2014 because the best code is the code never written and each lower rung adds maintenance cost."}, {"id": "_cline_skills_ponytail_skill_yagni", "label": "YAGNI Principle", "file_type": "concept", "source_file": ".cline/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_cline_skills_ponytail_skill_ponytail_comment_marker", "label": "ponytail: Comment Marker convention", "file_type": "concept", "source_file": ".cline/skills/ponytail/SKILL.md", "source_location": "Rules section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate simplifications are marked in code with a ponytail: comment naming the ceiling and the upgrade path, so a shortcut reads as intent rather than ignorance and can later be harvested into a debt ledger."}], "edges": [{"source": "_cline_skills_ponytail_skill_ponytail", "target": "_cline_skills_ponytail_skill_laziness_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".cline/skills/ponytail/SKILL.md", "source_location": "The ladder section", "weight": 1.0}, {"source"