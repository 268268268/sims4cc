{"nodes": [{"id": "plan_development_plan", "label": "Sims 4 Mod Manager Development Plan", "file_type": "document", "source_file": "PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staged so each stage is self-contained and shippable; security (Stage 0) precedes all features because Electron 31 stopped receiving Chromium patches while the app renders remote content from Tumblr/Patreon/CurseForge."}, {"id": "plan_security_hardening", "label": "Stage 0 Security Hardening (sandbox, CSP, safeStorage)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Stage 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Electron upgrade to 43, sandbox:true, contextIsolation, navigation guards, openExternal validation (https only), strict CSP via session.onHeadersReceived, and safeStorage encryption of the CurseForge key \u2014 all done before new features because the app opens login windows and renders untrusted remote content."}, {"id": "plan_conflict_detector", "label": "Mod Conflict Detector (TGI resource intersection)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Item 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Killer feature: reuse the existing DBPF parser to collect type/group/instance resource sets per .package and intersect them across mods; a whitelist of known-safe overlaps (tuning injectors, shared libraries) is required to avoid false positives."}, {"id": "plan_mod_profiles", "label": "Mod Profiles (named mod sets)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Item 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_auto_update", "label": "App Auto-Update (electron-updater + GitHub Releases)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Item 3.5", "source_